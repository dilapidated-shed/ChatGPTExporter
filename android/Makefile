# E1 sign-in packaging remains distinct from the integration's archive modules.
# Physical TAB_P10 ABI and storage have not yet been independently observed.
# Production signing/delivery require separate acceptance.
# All toolchain locations are explicit inputs from the verified build host.
CC_ARM64 ?=
CC_X86_64 ?=
BUILD_TOOLS ?=
ANDROID_JAR ?=
DEX_DIR ?=
DEX_SOURCE ?=
KEYSTORE ?=
CERT_SHA256 ?=
ANDROID_NDK ?=
NDK ?=
ICK_ARM64 ?=
ICK_X86_64 ?=
GREASE ?=
PRESENTATION_REPOSITORY ?=
IDRIC ?=
IDRIC_RUNTIME_LIBRARY ?= $(dir $(IDRIC))idris2_app/libidris2_support.so
SOURCE_COMMIT ?= $(shell git rev-parse HEAD)
NATIVE = $(CAPTURE_NATIVE) cgw_webview_android.c
CAPTURE_NATIVE = ../native/cgw_web.c ../native/cgw_webview_bridge.c ../native/cgw_webview_capture.c ../native/cgw_capture.c ../native/cgw_json.c ../native/cgw_views.c ../native/cgw_object_store.c ../native/cgw_sha256.c
CAPTURE_HEADERS = ../native/cgw_web.h ../native/cgw_webview_bridge.h ../native/cgw_webview_capture.h ../native/cgw_capture.h ../native/cgw_json.h ../native/cgw_views.h ../native/cgw_object_store.h ../native/cgw_sha256.h
FLAGS = -std=c11 -O2 -Wall -Wextra -Werror -fPIC -shared -pthread -Wl,--no-undefined -Wl,-z,max-page-size=16384 -I../native -DCGW_CAPTURE_SOURCE_IDENTITY='"$(SOURCE_COMMIT)"'

.PHONY: dex
dex:
	test -x "$(IDRIC)"
	test -f "$(ANDROID_NDK)/dex/idric/callback-shell.ipkg"
	cd "$(ANDROID_NDK)/dex/idric" && "$(IDRIC)" --build callback-shell.ipkg
	mkdir -p build/direct-dex
	IDRIS2_PATH="$(ANDROID_NDK)/dex/idric/build/ttc:$${IDRIS2_PATH}" "$(IDRIC)" --source-dir ../examples/autogenerated/android-export-shell ../examples/autogenerated/android-export-shell/ExporterShell.idric -o exporter-shell
	cp "$(IDRIC_RUNTIME_LIBRARY)" build/exec/exporter-shell_app/
	LD_LIBRARY_PATH="$(dir $(IDRIC_RUNTIME_LIBRARY)):$${LD_LIBRARY_PATH}" ./build/exec/exporter-shell
	cp -r build/direct-dex build/first-direct-dex
	LD_LIBRARY_PATH="$(dir $(IDRIC_RUNTIME_LIBRARY)):$${LD_LIBRARY_PATH}" ./build/exec/exporter-shell
	diff -r build/direct-dex build/first-direct-dex
	git rev-parse HEAD > build/direct-dex/source-commit.txt
	git -C "$(ANDROID_NDK)" rev-parse HEAD > build/direct-dex/producer-commit.txt
	sha256sum build/direct-dex/classes*.dex > build/direct-dex/dex.sha256

.PHONY: dex-check
dex-check:
	python3 "$(ANDROID_NDK)/dex/idric/tests/dex/check_dex.py" build/direct-dex/classes.dex
	python3 "$(ANDROID_NDK)/dex/idric/tests/dex/check_dex.py" build/direct-dex/classes2.dex
	python3 "$(ANDROID_NDK)/dex/idric/tests/dex/check_dex.py" build/direct-dex/classes3.dex
	python3 "$(ANDROID_NDK)/dex/idric/tests/dex/check_dex.py" build/direct-dex/classes4.dex

.PHONY: build native fixture validate verify-grease verify-dex
native: build/lib/arm64-v8a/libcgw_webview.so build/fixture/lib/x86_64/libcgw_webview.so native-capture
# Independent cross-compilation only; no archive start button in the E1 APK.
.PHONY: native-capture
native-capture: build/lib/arm64-v8a/libcgw_capture.so build/fixture/lib/x86_64/libcgw_capture.so

build/lib/arm64-v8a/libcgw_capture.so: $(CAPTURE_NATIVE) $(CAPTURE_HEADERS)
	test -x "$(CC_ARM64)"
	mkdir -p build/lib/arm64-v8a
	"$(CC_ARM64)" $(FLAGS) -Wl,--no-undefined $(CAPTURE_NATIVE) -o $@

build/fixture/lib/x86_64/libcgw_capture.so: $(CAPTURE_NATIVE) $(CAPTURE_HEADERS)
	test -x "$(CC_X86_64)"
	mkdir -p build/fixture/lib/x86_64
	"$(CC_X86_64)" $(FLAGS) -Wl,--no-undefined $(CAPTURE_NATIVE) -o $@
verify-grease:
	printf '%s  %s\n' '7e31cd05b7a9d8fb2a4a9e003a7f3fcb0159138506d17f0fb28da8cbe22aa85c' '$(GREASE)' | sha256sum -c -
	chmod +x "$(GREASE)"
	ASAN_OPTIONS=detect_leaks=0 "$(GREASE)" -n qualify.grease > /dev/null
build: verify-dex build/arm64-unsigned.apk build/fixture-unsigned.apk

verify-dex:
	test -n "$(DEX_SOURCE)"
	grep -qx "$(DEX_SOURCE)" "$(DEX_DIR)/source-commit.txt"

build/lib/arm64-v8a/libcgw_webview.so: $(NATIVE) cgw_capture_android.inc $(CAPTURE_HEADERS) cgw_reader.c cgw_reader.h ../native/cgw_presentation.c ../native/cgw_presentation.h build-reader.grease
	test -x "$(CC_ARM64)"
	mkdir -p build/lib/arm64-v8a
	"$(GREASE)" build-reader.grease "$(ICK_ARM64)" "$(NDK)" arm64-v8a "$(abspath ..)" "$(PRESENTATION_REPOSITORY)" "$(abspath build/reader/arm64-v8a)"
	"$(CC_ARM64)" $(FLAGS) $(NATIVE) build/reader/arm64-v8a/cgw_presentation.o build/reader/arm64-v8a/cgw_reader.o -llog -landroid -o $@

build/fixture/lib/x86_64/libcgw_webview.so: $(NATIVE) cgw_capture_android.inc $(CAPTURE_HEADERS) cgw_reader.c cgw_reader.h ../native/cgw_presentation.c ../native/cgw_presentation.h build-reader.grease
	test -x "$(CC_X86_64)"
	mkdir -p build/fixture/lib/x86_64
	"$(GREASE)" build-reader.grease "$(ICK_X86_64)" "$(NDK)" x86_64 "$(abspath ..)" "$(PRESENTATION_REPOSITORY)" "$(abspath build/reader/x86_64)"
	"$(CC_X86_64)" $(FLAGS) -DCGW_WEBVIEW_SYNTHETIC $(NATIVE) build/reader/x86_64/cgw_presentation.o build/reader/x86_64/cgw_reader.o -llog -landroid -o $@

# The production x86 payload has no synthetic transport. It is installed over
# the fixture with the same package/signer/UID for independent offline reading.
build/production/lib/x86_64/libcgw_webview.so: $(NATIVE) cgw_capture_android.inc $(CAPTURE_HEADERS) build/fixture/lib/x86_64/libcgw_webview.so
	mkdir -p build/production/lib/x86_64
	"$(CC_X86_64)" $(FLAGS) $(NATIVE) build/reader/x86_64/cgw_presentation.o build/reader/x86_64/cgw_reader.o -llog -landroid -o $@

build/arm64-unsigned.apk: build/lib/arm64-v8a/libcgw_webview.so AndroidManifest.xml assets/bridge.js
	test -f "$(DEX_DIR)/classes.dex"
	test -f "$(DEX_DIR)/classes2.dex"
	test -f "$(DEX_DIR)/classes3.dex"
	test -f "$(DEX_DIR)/classes4.dex"
	"$(BUILD_TOOLS)/aapt2" link -I "$(ANDROID_JAR)" --manifest AndroidManifest.xml --version-code 4 --version-name 0.3-views-candidate -o build/manifest.apk
	cp build/manifest.apk $@
	cp "$(DEX_DIR)"/classes*.dex build/
	mkdir -p build/package-arm64/lib/arm64-v8a build/package-arm64/assets
	cp build/classes*.dex build/package-arm64/
	cp build/lib/arm64-v8a/libcgw_webview.so build/package-arm64/lib/arm64-v8a/
	cp assets/bridge.js build/package-arm64/assets/
	TZ=UTC touch -t 198001010000 build/package-arm64/classes*.dex build/package-arm64/lib/arm64-v8a/libcgw_webview.so build/package-arm64/assets/bridge.js
	cd build/package-arm64 && TZ=UTC zip -X -D -q ../arm64-unsigned.apk classes.dex classes2.dex classes3.dex classes4.dex lib/arm64-v8a/libcgw_webview.so assets/bridge.js

build/fixture-unsigned.apk: build/fixture/lib/x86_64/libcgw_webview.so AndroidManifest.xml assets/bridge.js
	"$(BUILD_TOOLS)/aapt2" link -I "$(ANDROID_JAR)" --manifest AndroidManifest.xml --rename-manifest-package org.isomorphisms.chatgptexporter.e1fixture --version-code 1 --version-name e1-synthetic -o build/fixture-unsigned.apk
	cp "$(DEX_DIR)"/classes*.dex build/fixture/
	mkdir -p build/package-fixture/lib/x86_64 build/package-fixture/assets
	cp build/fixture/classes*.dex build/package-fixture/
	cp build/fixture/lib/x86_64/libcgw_webview.so build/package-fixture/lib/x86_64/
	cp assets/bridge.js build/package-fixture/assets/
	TZ=UTC touch -t 198001010000 build/package-fixture/classes*.dex build/package-fixture/lib/x86_64/libcgw_webview.so build/package-fixture/assets/bridge.js
	cd build/package-fixture && TZ=UTC zip -X -D -q ../fixture-unsigned.apk classes.dex classes2.dex classes3.dex classes4.dex lib/x86_64/libcgw_webview.so assets/bridge.js

fixture: build/fixture-unsigned.apk
	test -f "$(KEYSTORE)"
	test -n "$(CERT_SHA256)"
	keytool -exportcert -keystore "$(KEYSTORE)" -storetype PKCS12 -storepass wegert-debug -alias wegert-debug -file build/fixture-cert.der
	printf '%s  build/fixture-cert.der\n' '$(CERT_SHA256)' | sha256sum -c -
	"$(BUILD_TOOLS)/zipalign" -f 4 build/fixture-unsigned.apk build/fixture-aligned.apk
	"$(BUILD_TOOLS)/apksigner" sign --ks "$(KEYSTORE)" --ks-type PKCS12 --ks-pass pass:wegert-debug --key-pass pass:wegert-debug --ks-key-alias wegert-debug --out build/e1-synthetic.apk build/fixture-aligned.apk
	"$(BUILD_TOOLS)/apksigner" verify --verbose --print-certs build/e1-synthetic.apk

validate: build
	sha256sum build/arm64-unsigned.apk build/fixture-unsigned.apk build/lib/arm64-v8a/libcgw_webview.so build/fixture/lib/x86_64/libcgw_webview.so > build/build.sha256
	sha256sum AndroidManifest.xml assets/bridge.js cgw_webview_android.c "$(DEX_DIR)/classes.dex" "$(DEX_DIR)/classes2.dex" "$(DEX_DIR)/classes3.dex" >> build/build.sha256
	"$(CC_ARM64)" --version > build/compiler.txt
	git rev-parse HEAD > build/source-commit.txt
	"$(BUILD_TOOLS)/aapt2" dump badging build/arm64-unsigned.apk > build/arm64-manifest.txt
	unzip -l build/arm64-unsigned.apk > build/arm64-contents.txt
	grep -q 'lib/arm64-v8a/libcgw_webview.so' build/arm64-contents.txt
	grep -q 'classes3.dex' build/arm64-contents.txt

# Explicitly requested C67 development trial; signs the qualified ARM64 input.
.PHONY: c67-trial
c67-trial: build/arm64-unsigned.apk
	keytool -exportcert -keystore "$(KEYSTORE)" -storetype PKCS12 -storepass wegert-debug -alias wegert-debug -file build/c67-cert.der
	printf '%s  build/c67-cert.der\n' 'de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' | sha256sum -c -
	"$(BUILD_TOOLS)/zipalign" -P 16 -f 4 build/arm64-unsigned.apk build/c67-aligned.apk
	"$(BUILD_TOOLS)/apksigner" sign --ks "$(KEYSTORE)" --ks-type PKCS12 --ks-pass pass:wegert-debug --key-pass pass:wegert-debug --ks-key-alias wegert-debug --out build/chatgpt-exporter-c67-e1.apk build/c67-aligned.apk
	"$(BUILD_TOOLS)/apksigner" verify --verbose --print-certs build/chatgpt-exporter-c67-e1.apk > build/c67-signature.txt
	grep -q 'certificate SHA-256 digest: de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' build/c67-signature.txt
	"$(BUILD_TOOLS)/zipalign" -c -P 16 4 build/chatgpt-exporter-c67-e1.apk
	"$(BUILD_TOOLS)/aapt2" dump badging build/chatgpt-exporter-c67-e1.apk > build/c67-manifest.txt
	grep -q "native-code: 'arm64-v8a'" build/c67-manifest.txt
	sha256sum build/chatgpt-exporter-c67-e1.apk > build/c67.sha256

# Review candidate only: reuse the established E1 development certificate.
# No key generation, production promotion or installed-signer assumption.
.PHONY: development-candidate
development-candidate: build/arm64-unsigned.apk
	keytool -exportcert -keystore "$(KEYSTORE)" -storetype PKCS12 -storepass wegert-debug -alias wegert-debug -file build/development-cert.der
	printf '%s  build/development-cert.der\n' 'de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' | sha256sum -c -
	"$(BUILD_TOOLS)/zipalign" -P 16 -f 4 build/arm64-unsigned.apk build/arm64-aligned.apk
	"$(BUILD_TOOLS)/apksigner" sign --ks "$(KEYSTORE)" --ks-type PKCS12 --ks-pass pass:wegert-debug --key-pass pass:wegert-debug --ks-key-alias wegert-debug --out build/chatgpt-exporter-arm64-development-candidate.apk build/arm64-aligned.apk
	"$(BUILD_TOOLS)/apksigner" verify --verbose --print-certs build/chatgpt-exporter-arm64-development-candidate.apk > build/development-signature.txt
	grep -q 'certificate SHA-256 digest: de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' build/development-signature.txt
	"$(BUILD_TOOLS)/zipalign" -c -P 16 4 build/chatgpt-exporter-arm64-development-candidate.apk
	"$(BUILD_TOOLS)/aapt2" dump badging build/chatgpt-exporter-arm64-development-candidate.apk > build/development-manifest.txt
	sha256sum build/chatgpt-exporter-arm64-development-candidate.apk > build/development.sha256

.PHONY: reproduce-candidate
reproduce-candidate:
	cp build/arm64-unsigned.apk build/reproduction-first-unsigned.apk
	cp build/chatgpt-exporter-arm64-development-candidate.apk build/reproduction-first-signed.apk
	$(MAKE) -B build/arm64-unsigned.apk
	cmp build/reproduction-first-unsigned.apk build/arm64-unsigned.apk
	$(MAKE) development-candidate
	cmp build/reproduction-first-signed.apk build/chatgpt-exporter-arm64-development-candidate.apk
	sha256sum build/reproduction-first-unsigned.apk build/arm64-unsigned.apk build/reproduction-first-signed.apk build/chatgpt-exporter-arm64-development-candidate.apk > build/reproduction.sha256
