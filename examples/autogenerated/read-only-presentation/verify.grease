#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 4) { echo 'requires REPOSITORY AICI ICK NEW_OUTPUT' >&2; exit 2 }
var repository = ARGV[0]
var aici = ARGV[1]
var compiler = ARGV[2]
var output = ARGV[3]
test ! -e "$output"
mkdir -p "$output"
var native = "$repository/native"
"$compiler" -fno-link-libatomic -std=c11 -O2 -Wall -Wextra -Werror -pedantic \
  "-I$native" "$native/cgw_presentation.c" "$native/cgw_capture.c" "$native/cgw_json.c" \
  "$native/cgw_views.c" "$native/cgw_sha256.c" "$native/cgw_object_store.c" "$native/cgw_web.c" \
  "$aici/examples/autogenerated/native-presentation/ArchiveAcceptance.c" -o "$output/observer"
# The archive below was created by the existing credential-free synthetic TLS
# capture suite. Never accept an arbitrary user archive as a mutation target.
var archive = $(cat "$native/build/capture-success.path")
if (archive[0] !== '/') { setvar archive = "$native/$archive" }
"$output/observer" "$archive" > "$output/result.txt" 2>&1
cat "$output/result.txt"
cp -R "$archive" "$output/corrupt"
var identity = $(printf 'conversation-1' | sha256sum | cut -d ' ' -f 1)
printf '{}' > "$output/corrupt/conversation-$identity.json"
"$output/observer" "$output/corrupt" --refuse > "$output/corrupt-result.txt" 2>&1
sed 's/? CGW_ROLE_ASSISTANT/? CGW_ROLE_USER/' "$native/cgw_presentation.c" > "$output/wrong-role.c"
"$compiler" -fno-link-libatomic -std=c11 -O2 -Wall -Wextra -Werror -pedantic \
  "-I$native" "$output/wrong-role.c" "$native/cgw_capture.c" "$native/cgw_json.c" \
  "$native/cgw_views.c" "$native/cgw_sha256.c" "$native/cgw_object_store.c" "$native/cgw_web.c" \
  "$aici/examples/autogenerated/native-presentation/ArchiveAcceptance.c" -o "$output/wrong-role"
try { "$output/wrong-role" "$archive" > "$output/wrong-role-result.txt" 2>&1 }
if (_error.code !== 1) { echo 'FAIL wrong role producer mutation was not rejected' >&2; exit 1 }
rg -x -F 'FAIL normalized order, message identity and exact role' "$output/wrong-role-result.txt"
for mutation in wrong-order wrong-version {
  var pattern = 's/view->selected_count - 1 - position/position/'
  var marker = 'FAIL selected branch conversation order'
  if (mutation === 'wrong-version') {
    setvar pattern = 's/return CGW_PRESENTATION_INTERFACE_VERSION;/return CGW_PRESENTATION_INTERFACE_VERSION + 1;/'
    setvar marker = 'FAIL native presentation component version'
  }
  sed "$pattern" "$native/cgw_presentation.c" > "$output/$mutation.c"
  "$compiler" -fno-link-libatomic -std=c11 -O2 -Wall -Wextra -Werror -pedantic \
    "-I$native" "$output/$mutation.c" "$native/cgw_capture.c" "$native/cgw_json.c" \
    "$native/cgw_views.c" "$native/cgw_sha256.c" "$native/cgw_object_store.c" "$native/cgw_web.c" \
    "$aici/examples/autogenerated/native-presentation/ArchiveAcceptance.c" -o "$output/$mutation"
  try { "$output/$mutation" "$archive" > "$output/$mutation-result.txt" 2>&1 }
  if (_error.code !== 1) { echo "FAIL $mutation producer mutation was not rejected" >&2; exit 1 }
  rg -x -F "$marker" "$output/$mutation-result.txt"
}
sha256sum "$compiler" "$native/cgw_presentation.c" "$output/observer" > "$output/digests.txt"
git -C "$repository" rev-parse HEAD > "$output/source.txt"
printf '\033[32mPASS\033[0m actual native disk verification, read-only projection and corrupt-source refusal\n'
echo 'NOT_RUN actual user archive and Android UI integration'
